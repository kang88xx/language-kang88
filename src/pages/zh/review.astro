---
import Base from '../../layouts/Base.astro';
import Flashcard from '../../ui/Flashcard.astro';
import { NAV } from '../../ui/nav.ts';
import { getCollection } from 'astro:content';
import { zhVocabItems, zhSentenceItems, zhFixItems } from '../../core/convert.ts';
const [v, l, f] = await Promise.all([getCollection('zhVocab'), getCollection('zhLessons'), getCollection('zhFixes')]);
const byDateDesc = <T extends { date: string }>(a: T, b: T) => b.date.localeCompare(a.date);
const items = [...zhVocabItems(v.map((x) => x.data).sort(byDateDesc)), ...zhFixItems(f.map((x) => x.data).sort(byDateDesc)), ...zhSentenceItems(l.map((x) => x.data).sort(byDateDesc))];
---
<Base title="중국어 복습" domain="zh" nav={[...NAV.zh]}>
  <div class="page-head"><h1>복습</h1><span class="sub">최신 수업부터 단어 → 교정 → 문장 순으로 새 카드가 추가됩니다 · 전체 {items.length}장</span></div>
  <Flashcard items={items} domain="zh" />
</Base>
