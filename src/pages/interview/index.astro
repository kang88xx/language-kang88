---
import Base from '../../layouts/Base.astro';
import Search from '../../ui/Search.astro';
import Empty from '../../ui/Empty.astro';
import { NAV } from '../../ui/nav.ts';
import { getCollection } from 'astro:content';
const ORDER = ['intro', 'career', 'tech', 'behavioral', 'culture'];
const qs = (await getCollection('interviewQuestions')).sort((a, b) => ORDER.indexOf(a.data.category) - ORDER.indexOf(b.data.category) || Number(b.data.star) - Number(a.data.star));
const CAT: Record<string, string> = { intro: '자기소개', career: '경력', tech: '기술', behavioral: '행동·상황', culture: '회사·문화' };
const LANG: Record<string, string> = { ko: '한국어', en: '영어', zh: '중국어' };
---
<Base title="면접 질문 은행" domain="interview" nav={[...NAV.interview]}>
  <div class="page-head"><h1>질문 은행</h1><span class="sub"><span data-count>{qs.length}</span>개 · 답변은 이 브라우저에만 저장됩니다</span><a class="btn btn-filled btn-sm" href="/interview/practice/">▶ 연습 시작</a></div>
  <div data-filter-root>
    <Search placeholder="질문 · 태그 검색" selects={[{ key: 'category', label: '분류', options: Object.entries(CAT) }, { key: 'lang', label: '언어', options: Object.entries(LANG) }]} />
    <div class="grid">
      {qs.map((q) => <a class="card link" href={`/interview/q/${q.id}/`} data-hay={`${q.data.q} ${q.data.tags.join(' ')} ${CAT[q.data.category]}`} data-category={q.data.category} data-lang={q.data.lang}>
        <div class="chips" style="margin-bottom:6px"><span class="chip chip-domain">{CAT[q.data.category]}</span><span class="chip">{LANG[q.data.lang]}</span>{q.data.star && <span class="chip chip-yellow">★ 핵심</span>}</div>
        <div style="font-size:1.05rem;font-weight:500" lang={q.data.lang === 'zh' ? 'zh-CN' : q.data.lang}>{q.data.q}</div>
        {q.data.hint && <div class="small muted" style="margin-top:6px">{q.data.hint}</div>}
      </a>)}
    </div>
    <Empty />
  </div>
  <script src="../../modules/filter.ts"></script>
</Base>
